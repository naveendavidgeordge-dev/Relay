# ---------------------------------------------------------------------------
# Relay environment. Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
DATABASE_URL=jdbc:postgresql://localhost:5432/relay
DATABASE_USER=relay
DATABASE_PASSWORD=relay

# --- Platform auth --------------------------------------------------------
# Demo bearer token accepted on all platform APIs (builder + operator + approver).
RELAY_DEMO_TOKEN=relay-demo-token
# Optional: PEM RSA public key (single line, \n escaped) to also accept RS256 JWTs.
RELAY_JWT_PUBLIC_KEY=
RELAY_JWT_ISSUER=relay

# --- Process role ---------------------------------------------------------
# false = API (+ in-process worker when SPRING_PROFILES_ACTIVE is unset); true = worker only.
WORKER_ONLY=false
RELAY_WORKER_CONCURRENCY=4
RELAY_LEASE_SECONDS=15
RELAY_POLL_INTERVAL_MS=250

# --- External world -------------------------------------------------------
MOCK_WORLD_URL=http://localhost:9210
# Comma-separated "from=>to" prefix rewrites for http_request URLs (stored definitions are untouched).
# Inside docker-compose: http://localhost:9210=>http://mock-world:9210
RELAY_URL_ALIASES=
# Optional comma-separated host allowlist for http_request nodes (empty = any host). SSRF guard.
RELAY_HTTP_ALLOWED_HOSTS=
RELAY_HTTP_CONNECT_TIMEOUT_MS=2000
RELAY_HTTP_READ_TIMEOUT_MS=10000

# --- Retries --------------------------------------------------------------
RELAY_RETRY_MAX_ATTEMPTS=5
RELAY_RETRY_INITIAL_INTERVAL_MS=500
RELAY_RETRY_MULTIPLIER=2.0
RELAY_RETRY_MAX_INTERVAL_MS=8000

# --- AI sidecar -----------------------------------------------------------
AI_SIDECAR_URL=http://localhost:8090
AI_SIDECAR_TIMEOUT_MS=30000
# NL compiler strategy: heuristic (no model needed) | llm
RELAY_COMPILER_MODE=heuristic
# mock | gemini | groq | ollama
AI_PROVIDER=mock
AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434
# Full prompts are only logged when true.
AI_LOG_PROMPTS=false
# Mock provider: make the first answer for each prompt schema-invalid to demo the repair retry.
MOCK_AI_FIRST_INVALID=false

# --- Post-quantum crypto --------------------------------------------------
# bouncycastle | test
RELAY_PQ_PROVIDER=bouncycastle
# 32 random bytes, base64. KEK that wraps the ML-KEM-768 / X25519 / ML-DSA-65 private keys.
# Generate: openssl rand -base64 32
RELAY_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1jaGFuZ2UtbWUtMzI=
# pgcrypto pgp_sym_encrypt key (defense in depth around the envelope ciphertext).
RELAY_DB_COLUMN_KEY=dev-only-column-key-change-me

# --- Transport ------------------------------------------------------------
# Optional mTLS between backend, sidecar and mock world (see DESIGN/05).
RELAY_MTLS_ENABLED=false

# --- Frontend -------------------------------------------------------------
# Server-side only: the console's route handlers attach the token, the browser never sees it.
RELAY_API_URL=http://localhost:8080
RELAY_API_TOKEN=relay-demo-token
NEXT_PUBLIC_APP_NAME=Relay
